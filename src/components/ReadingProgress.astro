---
<div
  class="reading-progress"
  role="progressbar"
  aria-label="Reading progress"
  aria-valuenow="0"
  aria-valuemin="0"
  aria-valuemax="100"
></div>

<script>
  (function () {
    const bar = document.querySelector('.reading-progress') as HTMLElement | null;
    const article = document.querySelector('article.prose') as HTMLElement | null;

    if (bar && article) {
      let articleTop: number;

      const computeArticleTop = () => {
        articleTop = article.getBoundingClientRect().top + window.scrollY;
      };

      const updateProgress = () => {
        const articleHeight = article.offsetHeight;
        const scrolled = window.scrollY - articleTop;
        const percent = Math.min(100, Math.max(0, (scrolled / articleHeight) * 100));
        bar.style.width = `${percent}%`;
        bar.setAttribute('aria-valuenow', String(Math.round(percent)));
      };

      computeArticleTop();
      window.addEventListener('resize', computeArticleTop, { passive: true });
      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
    }
  })();
</script>
