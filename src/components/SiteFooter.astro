---
---
<footer class="site-footer" role="contentinfo">

  <div class="footer-grid">

    <!-- Column 1: Logo and tagline -->
    <div class="footer-col footer-col--brand">
      <div class="footer-brand">
        <img
          src="/images/cillian-portrait.png"
          alt="Cillian BC"
          class="footer-portrait"
          width="60"
          height="66"
          loading="lazy"
        />
        <a href="/" class="footer-wordmark">Cillian BC</a>
      </div>
      <p class="footer-tagline">
        Independent AI search consultant helping Irish businesses stay
        visible as search moves to AI-generated answers.
      </p>
    </div>

    <!-- Column 2: Navigation -->
    <nav class="footer-col footer-col--nav" aria-label="Footer navigation">
      <ul class="footer-nav">
        <li><a href="/">Home</a></li>
        <li><a href="/services">Services</a></li>
        <li><a href="/automation">Automation</a></li>
        <li><a href="/aeo-geo">AEO/GEO</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/insights">Insights</a></li>
        <li><a href="mailto:hello@cillianbc.com">Contact</a></li>
      </ul>
    </nav>

    <!-- Column 3: Contact and legal -->
    <div class="footer-col footer-col--contact footer-contact">
      <a href="mailto:hello@cillianbc.com" class="footer-contact__link">
        Start a conversation
      </a>
      <small class="footer-contact__legal">
        &copy; 2026 Cillian BC. No cookies tracked.
      </small>
    </div>

  </div>

  <!-- Certifications & Partnerships -->
  <div class="footer-credentials">
    <p class="footer-credentials__label">Certifications &amp; Partnerships</p>
    <div class="footer-credentials__badges">
      <img
        src="/images/google-partner.png"
        alt="Google Partner"
        class="footer-credentials__badge"
        height="40"
        width="105"
        loading="lazy"
      />
      <img
        src="/images/airops-certified-expert.png"
        alt="AirOps Certified Expert"
        class="footer-credentials__badge"
        height="40"
        width="40"
        loading="lazy"
      />
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom">
    <span class="footer-bottom__copyright">&copy; 2026 Cillian BC</span>
    <span class="footer-bottom__provenance">Made in Ireland</span>
  </div>

</footer>
