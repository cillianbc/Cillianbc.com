---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;
---
<BaseLayout
  title="Page not found | Cillian BC"
  description="The page you were looking for does not exist."
  noindex={true}
>
  <div class="page-404">
    <p class="error-label" aria-hidden="true">404</p>
    <h1>This page doesn't exist.</h1>
    <p class="error-body">The page you were looking for has moved or never existed. If you followed a link from somewhere and expected to land somewhere useful, email <a href="mailto:hello@cillianbc.com">hello@cillianbc.com</a> and I'll sort it out.</p>
    <nav class="error-nav" aria-label="Return to site">
      <a href="/">Homepage</a>
      <span aria-hidden="true">·</span>
      <a href="/services">Services</a>
      <span aria-hidden="true">·</span>
      <a href="/about">About</a>
    </nav>
  </div>
</BaseLayout>
